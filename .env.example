# Copy this file to .env and fill in your keys. Never commit .env.

# Which model the agent uses, as "provider:model-name".
MODEL=groq:llama-3.3-70b-versatile

# Free key from https://console.groq.com
GROQ_API_KEY=

# Optional: only needed if you switch MODEL to one of these providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: LangSmith tracing, handy for seeing every agent step
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=expense-buddy

# Where the SQLite file lives (defaults to ./expenses.db)
EXPENSE_DB_PATH=expenses.db
